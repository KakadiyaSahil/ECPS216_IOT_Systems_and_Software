        "func": "// let inputData = msg.payload; // Assuming the input data is a string\n\n// // Initialize result containers\n// let cumulativeTimes = [];\n// let logEntries = [];\n\n// // Regex patterns\n// let masterRegex = /Master Device:\\s*(\\w+),\\s*IP-Address\\s*:\\s*([\\d.]+),\\s*Color:\\s*(\\w+),\\s*Cumulative Time:\\s*([\\d.]+)\\s*seconds/;\n// let logRegex = /{.*?}/g;\n\n// // Extract cumulative times\n// let masterMatches = inputData.match(new RegExp(masterRegex, \"g\"));\n// if (masterMatches) {\n//     masterMatches.forEach((entry) => {\n//         let match = entry.match(masterRegex);\n//         if (match) {\n//             cumulativeTimes.push({\n//                 master_device: match[1],\n//                 ip_address: match[2],\n//                 color: match[3],\n//                 cumulative_time: parseFloat(match[4])\n//             });\n//         }\n//     });\n// }\n\n// // Extract log entries\n// let logMatches = inputData.match(logRegex);\n// if (logMatches) {\n//     logMatches.forEach((log) => {\n//         try {\n//             logEntries.push(JSON.parse(log.replace(/'/g, '\"'))); // Convert to JSON\n//         } catch (error) {\n//             node.warn(\"Error parsing log entry: \" + log);\n//         }\n//     });\n// }\n\n// // Set outputs\n// msg.payload = {\n//     cumulative_times: cumulativeTimes,\n//     log_entries: logEntries\n// };\n\n// let secondOutputMsg = { payload: logEntries };\n// return [msg, secondOutputMsg];\n\n// let inputData = msg.payload; // Assuming the input data is a string\n\n// // Initialize result containers\n// let cumulativeTimes = [];\n// let logEntries = [];\n\n// // Regex patterns\n// let masterRegex = /Master Device:\\s*(\\w+),\\s*IP-Address\\s*:\\s*([\\d.]+),\\s*Color:\\s*(\\w+),\\s*Cumulative Time:\\s*([\\d.]+)\\s*seconds/;\n// let logRegex = /{.*?}/g;\n\n// // Extract cumulative times\n// let masterMatches = inputData.match(new RegExp(masterRegex, \"g\"));\n// if (masterMatches) {\n//     masterMatches.forEach((entry) => {\n//         let match = entry.match(masterRegex);\n//         if (match) {\n//             cumulativeTimes.push({\n//                 master_device: match[1],\n//                 ip_address: match[2],\n//                 color: match[3],\n//                 cumulative_time: parseFloat(match[4])\n//             });\n//         }\n//     });\n// }\n\n// // Extract log entries\n// let logMatches = inputData.match(logRegex);\n// if (logMatches) {\n//     logMatches.forEach((log) => {\n//         try {\n//             logEntries.push(JSON.parse(log.replace(/'/g, '\"'))); // Convert to JSON\n//         } catch (error) {\n//             node.warn(\"Error parsing log entry: \" + log);\n//         }\n//     });\n// }\n\n// // Set outputs\n// let secondOutputMsg = { payload: logEntries };\n// return [{ cumulative_times: cumulativeTimes }, secondOutputMsg ];\n\n\n\n\nlet inputData = msg.payload; // Assuming the input data is a string\n\n// Initialize result containers\nlet cumulativeTimes = [];\nlet logEntries = [];\n\n// Regex patterns\nlet masterRegex = /Master Device:\\s*(\\w+),\\s*IP-Address\\s*:\\s*([\\d.]+),\\s*Color:\\s*(\\w+),\\s*Cumulative Time:\\s*([\\d.]+)\\s*seconds/;\nlet logRegex = /{.*?}/g;\n\n// Extract cumulative times\nlet masterMatches = inputData.match(new RegExp(masterRegex, \"g\"));\nif (masterMatches) {\n    masterMatches.forEach((entry) => {\n        let match = entry.match(masterRegex);\n        if (match) {\n            cumulativeTimes.push({\n                master_device: match[1],\n                ip_address: match[2],\n                color: match[3],\n                cumulative_time: parseFloat(match[4])\n            });\n        }\n    });\n}\n\n// Extract log entries\nlet logMatches = inputData.match(logRegex);\nif (logMatches) {\n    logMatches.forEach((log) => {\n        try {\n            logEntries.push(JSON.parse(log.replace(/'/g, '\"'))); // Convert to JSON\n        } catch (error) {\n            node.warn(\"Error parsing log entry: \" + log);\n        }\n    });\n}\n\n// Set outputs\nreturn [\n    { payload: cumulativeTimes }, // First output with cumulativeTimes\n    { payload: logEntries }      // Second output with logEntries\n];",
