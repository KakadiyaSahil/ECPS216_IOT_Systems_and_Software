    {
        "id": "4eb161042c7f5981",
        "type": "function",
        "z": "164728d22bb9d6f8",
        "name": "Sperator Each Master Data",
        "func": "// Log incoming payload to verify structure\n// node.warn(\"Incoming Payload: \" + JSON.stringify(msg.payload));\n\nlet index = 0; // Index to track sequential sending through payload array\n\nfunction sendNext() {\n    try {\n        if (index < msg.payload.length) {\n            // Process one payload at a time\n            let newMsg = {\n                topic: msg.payload[index][\"Device ID\"], // Set topic to Device ID\n                payload: msg.payload[index][\"Up Time\"], // Set payload to Up Time\n                color: msg.payload[index][\"color\"] // Send the color too\n            };\n\n            node.send(newMsg); // Send the payload\n            index++;\n\n            // Wait for a short delay before processing the next item\n            setTimeout(sendNext, 100);\n        } else {\n            // node.warn(\"All messages sent.\");\n        }\n    } catch (error) {\n        node.error(\"Error during processing: \" + error);\n    }\n}\n\n// Start the sequential sending process\nsendNext();",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
