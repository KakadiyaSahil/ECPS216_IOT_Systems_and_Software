    {
        "id": "d690c973f1846b9b",
        "type": "function",
        "z": "164728d22bb9d6f8",
        "name": "get the log files",
        "func": "// // Example dynamic list generation\n// let files = [\n//     \"/home/sahilkakadiya/my_logs/log.txt\",\n//     \"/home/sahilkakadiya/Desktop/ECPS 216 - F'24 IOT/Assiginment -5 /Light Swarm  The Plot Thickens/my_logs/log_2024-12-05_21-54-34.txt\",\n//     \"log_3.txt\",\n//     \"log_4.txt\"\n// ];\n\n// // Map the filenames to Dropdown options\n// msg.options = files\n\n// // Send these options to populate the Dropdown node\n// return msg;\n\n\n\n// Log the incoming payload for debugging\n// node.warn(\"Incoming Payload: \" + JSON.stringify(msg.payload));\n\ntry {\n    let filePaths = []; // Initialize an array to store the file paths\n\n    // Iterate through the payload array using a for loop\n    for (let i = 0; i < msg.payload.length; i++) {\n        // Extract the 'name' field from the current object\n        let filePath = msg.payload[i].name;\n\n        // Add the extracted file path to the filePaths array\n        filePaths.push(filePath);\n    }\n\n    // Log the extracted file paths for debugging\n    // node.warn(\"Extracted File Paths: \" + JSON.stringify(filePaths));\n\n    // Update the message payload with the extracted file paths\n    msg.options = filePaths;\n\n    // Return the updated message to send it to the next node\n    return msg;\n\n} catch (error) {\n    // Log an error if something goes wrong\n    node.error(\"Error extracting file paths: \" + error);\n    return null; // Stop processing in case of an error\n}",
