        "func": "// Log incoming payload for debugging\n// node.warn(\"Incoming Payload: \" + JSON.stringify(msg.payload));\n\ntry {\n\n    let  log_entry_no =  msg.payload.log_entry_no;\n    let  timestamp =  msg.payload.timestamp;\n    let master_device = msg.payload.master_device;\n    let ip_address = msg.payload.ip_address;\n    let  color =  msg.payload.color;\n    let  ldr_value = msg.payload.ldr_value;\n\n    // Send extracted values as payload\n    // Send extracted ldr_value and color data together\n    \n    msg.topic = master_device;\n    msg.payload = ldr_value;\n    return msg; // Send the payload\n    \n\n} catch (error) {\n    node.error(\"Error extracting payload: \" + error);\n}",
